    .port_info 3 /OUTPUT 8 "y";
v0x58472c6d70e0_0 .net *"_ivl_0", 7 0, L_0x58472c6d7f20;  1 drivers
v0x58472c6d71c0_0 .net *"_ivl_2", 7 0, L_0x58472c6d8040;  1 drivers
