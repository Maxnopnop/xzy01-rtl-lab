    %join;
    %load/vec4 v0x58472c6d7b10_0;
    %addi 1, 0, 32;
    %store/vec4 v0x58472c6d7b10_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %vpi_func 3 26 "$value$plusargs" 32, "nonce=%s", v0x58472c6d7bf0_0 {0 0 0};
    %nor/r;
