v0x58472c6d7440_0 .net "right", 0 0, v0x58472c6d7cd0_0;  1 drivers
v0x58472c6d7550_0 .net "y", 7 0, L_0x58472c6d80e0;  alias, 1 drivers
L_0x58472c6d7f20 .shift/r 8, v0x58472c6d76b0_0, v0x58472c6d7790_0;
L_0x58472c6d8040 .shift/l 8, v0x58472c6d76b0_0, v0x58472c6d7790_0;
