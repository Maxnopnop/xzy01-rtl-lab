{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule fifo4x8(\n    input  wire       clk,\n    input  wire       rst,\n    input  wire       wr_en,\n    input  wire       rd_en,\n    input  wire [7:0] wdata,\n    output wire       full,\n    output wire       empty,\n    output reg  [2:0] count,\n    output wire [7:0] rdata\n);\n\n    reg [7:0] mem [0:3];\n    reg [1:0] wr_ptr;\n    reg [1:0] rd_ptr;\n\n    wire write_accept = wr_en && (count < 3'd4);\n    wire read_accept  = rd_en && (count > 3'd0);\n\n    assign full  = (count == 3'd4);\n    assign empty = (count == 3'd0);\n    assign rdata = empty ? 8'd0 : mem[rd_ptr];\n\n    always @(posedge clk) begin\n        if (rst) begin\n            count  <= 3'd0;\n            wr_ptr <= 2'd0;\n            rd_ptr <= 2'd0;\n        end else begin\n            if (write_accept) begin\n                mem[wr_ptr] <= wdata;\n                wr_ptr      <= wr_ptr + 2'd1;\n            end\n\n            if (read_accept)\n                rd_ptr <= rd_ptr + 2'd1;\n\n            case ({write_accept, read_accept})\n                2'b10: count <= count + 3'd1;\n                2'b01: count <= count - 3'd1;\n                default: count <= count;\n            endcase\n        end\n    end\n\nendmodule\n```"}}
