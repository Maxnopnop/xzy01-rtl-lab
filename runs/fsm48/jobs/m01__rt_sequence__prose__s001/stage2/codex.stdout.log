{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule sequence_detector (\n    input  wire clk,\n    input  wire rst_n,\n    input  wire data_in,\n    output wire sequence_detected\n);\n\n    localparam [2:0] IDLE = 3'd0;\n    localparam [2:0] S1   = 3'd1;\n    localparam [2:0] S2   = 3'd2;\n    localparam [2:0] S3   = 3'd3;\n    localparam [2:0] S4   = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    always @(*) begin\n        case (state)\n            IDLE: begin\n                if (data_in)\n                    next_state = S1;\n                else\n                    next_state = IDLE;\n            end\n\n            S1: begin\n                if (data_in)\n                    next_state = S1;\n                else\n                    next_state = S2;\n            end\n\n            S2: begin\n                if (data_in)\n                    next_state = S1;\n                else\n                    next_state = S3;\n            end\n\n            S3: begin\n                if (data_in)\n                    next_state = S4;\n                else\n                    next_state = IDLE;\n            end\n\n            S4: begin\n                if (data_in)\n                    next_state = S1;\n                else\n                    next_state = S2;\n            end\n\n            default: next_state = IDLE;\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= IDLE;\n        else\n            state <= next_state;\n    end\n\n    assign sequence_detected = (state == S4);\n\nendmodule\n```"}}
