{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule TopModule (\n    input  clk,\n    input  areset,\n    input  in,\n    output out\n);\n\n    localparam [1:0] A = 2'b00;\n    localparam [1:0] B = 2'b01;\n    localparam [1:0] C = 2'b10;\n    localparam [1:0] D = 2'b11;\n\n    reg [1:0] state, next_state;\n\n    always @(posedge clk or posedge areset) begin\n        if (areset)\n            state <= A;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            A: next_state = in ? B : A;\n            B: next_state = in ? B : C;\n            C: next_state = in ? D : A;\n            D: next_state = in ? B : C;\n            default: next_state = A;\n        endcase\n    end\n\n    assign out = (state == D);\n\nendmodule\n```"}}
