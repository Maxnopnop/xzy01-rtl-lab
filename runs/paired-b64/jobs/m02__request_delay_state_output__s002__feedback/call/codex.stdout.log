{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule request_delay(\n    input clk,\n    input rst_n,\n    input din,\n    output q\n);\n\n    localparam S_IDLE     = 2'b00;\n    localparam S_DELAY    = 2'b01;\n    localparam S_ASSERTED = 2'b10;\n    localparam S_COOLDOWN = 2'b11;\n\n    reg [1:0] state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state <= S_IDLE;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    if (din)\n                        state <= S_DELAY;\n                    else\n                        state <= S_IDLE;\n                end\n                S_DELAY: begin\n                    state <= S_ASSERTED;\n                end\n                S_ASSERTED: begin\n                    state <= S_COOLDOWN;\n                end\n                S_COOLDOWN: begin\n                    if (din)\n                        state <= S_COOLDOWN;\n                    else\n                        state <= S_IDLE;\n                end\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    assign q = (state == S_ASSERTED);\n\nendmodule\n```"}}
