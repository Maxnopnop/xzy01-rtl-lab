{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3 (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    reg [2:0] state;\n\n    localparam S0 = 3'd0,\n               S1 = 3'd1,\n               S2 = 3'd2,\n               S3 = 3'd3,\n               S4 = 3'd4;\n\n    assign q = (state == S3) || (state == S4);\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state <= S0;\n        end else begin\n            case (state)\n                S0: begin\n                    if (din)\n                        state <= S1;\n                    else\n                        state <= S0;\n                end\n                S1: begin\n                    if (din)\n                        state <= S2;\n                    else\n                        state <= S0;\n                end\n                S2: begin\n                    if (din)\n                        state <= S3;\n                    else\n                        state <= S0;\n                end\n                S3: begin\n                    if (din)\n                        state <= S3;\n                    else\n                        state <= S4;\n                end\n                S4: begin\n                    if (din)\n                        state <= S3;\n                    else\n                        state <= S0;\n                end\n                default: state <= S0;\n            endcase\n        end\n    end\n\nendmodule\n```"}}
