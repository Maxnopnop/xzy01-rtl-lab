{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3 (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    localparam S_LOW   = 3'd0;\n    localparam S_ONE   = 3'd1;\n    localparam S_TWO   = 3'd2;\n    localparam S_HIGH  = 3'd3;\n    localparam S_ZERO  = 3'd4;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S_LOW;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            S_LOW: begin\n                if (din)\n                    next_state = S_ONE;\n                else\n                    next_state = S_LOW;\n            end\n            S_ONE: begin\n                if (din)\n                    next_state = S_TWO;\n                else\n                    next_state = S_LOW;\n            end\n            S_TWO: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_LOW;\n            end\n            S_HIGH: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_ZERO;\n            end\n            S_ZERO: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_LOW;\n            end\n            default: next_state = S_LOW;\n        endcase\n    end\n\n    assign q = (state == S_HIGH) || (state == S_ZERO);\n\nendmodule\n```"}}
