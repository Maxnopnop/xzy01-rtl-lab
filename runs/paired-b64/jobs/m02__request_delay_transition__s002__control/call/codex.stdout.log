{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule request_delay(\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam IDLE     = 2'b00;\n    localparam ASSERT_Q = 2'b01;\n    localparam COOLDOWN = 2'b10;\n\n    reg [1:0] state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state <= IDLE;\n        end else begin\n            case (state)\n                IDLE: begin\n                    if (din)\n                        state <= ASSERT_Q;\n                    else\n                        state <= IDLE;\n                end\n                ASSERT_Q: begin\n                    state <= COOLDOWN;\n                end\n                COOLDOWN: begin\n                    if (din)\n                        state <= COOLDOWN;\n                    else\n                        state <= IDLE;\n                end\n                default: begin\n                    state <= IDLE;\n                end\n            endcase\n        end\n    end\n\n    assign q = (state == ASSERT_Q);\n\nendmodule\n```"}}
