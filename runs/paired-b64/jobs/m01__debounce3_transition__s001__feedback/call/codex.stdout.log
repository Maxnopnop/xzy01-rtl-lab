{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3 (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam [2:0] S0 = 3'd0;\n    localparam [2:0] S1 = 3'd1;\n    localparam [2:0] S2 = 3'd2;\n    localparam [2:0] S3 = 3'd3;\n    localparam [2:0] S4 = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    assign q = (state == S3) || (state == S4);\n\n    always @(*) begin\n        case (state)\n            S0: begin\n                if (din)\n                    next_state = S1;\n                else\n                    next_state = S0;\n            end\n            S1: begin\n                if (din)\n                    next_state = S2;\n                else\n                    next_state = S0;\n            end\n            S2: begin\n                if (din)\n                    next_state = S3;\n                else\n                    next_state = S0;\n            end\n            S3: begin\n                if (din)\n                    next_state = S3;\n                else\n                    next_state = S4;\n            end\n            S4: begin\n                if (din)\n                    next_state = S3;\n                else\n                    next_state = S0;\n            end\n            default: begin\n                next_state = S0;\n            end\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else\n            state <= next_state;\n    end\n\nendmodule\n```"}}
