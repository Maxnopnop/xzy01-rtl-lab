{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule request_delay (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output reg q\n);\n\n    localparam [1:0] IDLE     = 2'b00;\n    localparam [1:0] DELAY    = 2'b01;\n    localparam [1:0] PULSE    = 2'b10;\n    localparam [1:0] COOLDOWN = 2'b11;\n\n    reg [1:0] state;\n    reg [1:0] next_state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= IDLE;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (din)\n                    next_state = DELAY;\n                else\n                    next_state = IDLE;\n            end\n            DELAY: begin\n                next_state = PULSE;\n            end\n            PULSE: begin\n                next_state = COOLDOWN;\n            end\n            COOLDOWN: begin\n                if (din)\n                    next_state = COOLDOWN;\n                else\n                    next_state = IDLE;\n            end\n            default: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    always @(*) begin\n        case (state)\n            PULSE:   q = 1'b1;\n            default: q = 1'b0;\n        endcase\n    end\n\nendmodule\n```"}}
