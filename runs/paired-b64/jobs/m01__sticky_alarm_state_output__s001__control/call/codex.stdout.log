{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule sticky_alarm (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam S0 = 2'b00;\n    localparam S1 = 2'b01;\n    localparam S2 = 2'b10;\n\n    reg [1:0] state;\n    reg [1:0] next_state;\n    reg q;\n\n    always @(*) begin\n        next_state = state;\n        case (state)\n            S0: begin\n                if (din)\n                    next_state = S1;\n                else\n                    next_state = S0;\n            end\n            S1: begin\n                if (din)\n                    next_state = S2;\n                else\n                    next_state = S0;\n            end\n            S2: begin\n                next_state = S2;\n            end\n            default: begin\n                next_state = S0;\n            end\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            S2:      q = 1'b1;\n            default: q = 1'b0;\n        endcase\n    end\n\nendmodule\n```"}}
