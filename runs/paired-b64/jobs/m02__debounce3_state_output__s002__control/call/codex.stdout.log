{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3(\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam S0 = 3'd0;\n    localparam S1 = 3'd1;\n    localparam S2 = 3'd2;\n    localparam S3 = 3'd3;\n    localparam S4 = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    always @(*) begin\n        case (state)\n            S0: begin\n                if (din) next_state = S1;\n                else     next_state = S0;\n            end\n            S1: begin\n                if (din) next_state = S2;\n                else     next_state = S0;\n            end\n            S2: begin\n                if (din) next_state = S3;\n                else     next_state = S0;\n            end\n            S3: begin\n                if (din) next_state = S3;\n                else     next_state = S4;\n            end\n            S4: begin\n                if (din) next_state = S3;\n                else     next_state = S0;\n            end\n            default: next_state = S0;\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else\n            state <= next_state;\n    end\n\n    assign q = (state == S3) || (state == S4);\n\nendmodule\n```"}}
