{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3(\n    input  clk,\n    input  rst_n,\n    input  din,\n    output reg q\n);\n\n    localparam [2:0] LOW_0  = 3'd0;\n    localparam [2:0] LOW_1  = 3'd1;\n    localparam [2:0] LOW_2  = 3'd2;\n    localparam [2:0] HIGH_0 = 3'd3;\n    localparam [2:0] HIGH_1 = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= LOW_0;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            LOW_0: begin\n                if (din)\n                    next_state = LOW_1;\n                else\n                    next_state = LOW_0;\n            end\n            LOW_1: begin\n                if (din)\n                    next_state = LOW_2;\n                else\n                    next_state = LOW_0;\n            end\n            LOW_2: begin\n                if (din)\n                    next_state = HIGH_0;\n                else\n                    next_state = LOW_0;\n            end\n            HIGH_0: begin\n                if (din)\n                    next_state = HIGH_0;\n                else\n                    next_state = HIGH_1;\n            end\n            HIGH_1: begin\n                if (din)\n                    next_state = HIGH_0;\n                else\n                    next_state = LOW_0;\n            end\n            default: next_state = LOW_0;\n        endcase\n    end\n\n    always @(*) begin\n        case (state)\n            HIGH_0: q = 1'b1;\n            HIGH_1: q = 1'b1;\n            default: q = 1'b0;\n        endcase\n    end\n\nendmodule\n```"}}
