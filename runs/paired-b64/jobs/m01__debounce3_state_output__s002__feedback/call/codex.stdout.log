{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3 (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam [2:0] S_LOW      = 3'd0;\n    localparam [2:0] S_LOW_1    = 3'd1;\n    localparam [2:0] S_LOW_2    = 3'd2;\n    localparam [2:0] S_HIGH     = 3'd3;\n    localparam [2:0] S_HIGH_1   = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    assign q = (state == S_HIGH) || (state == S_HIGH_1);\n\n    always @(*) begin\n        case (state)\n            S_LOW: begin\n                if (din)\n                    next_state = S_LOW_1;\n                else\n                    next_state = S_LOW;\n            end\n\n            S_LOW_1: begin\n                if (din)\n                    next_state = S_LOW_2;\n                else\n                    next_state = S_LOW;\n            end\n\n            S_LOW_2: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_LOW;\n            end\n\n            S_HIGH: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_HIGH_1;\n            end\n\n            S_HIGH_1: begin\n                if (din)\n                    next_state = S_HIGH;\n                else\n                    next_state = S_LOW;\n            end\n\n            default: begin\n                next_state = S_LOW;\n            end\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S_LOW;\n        else\n            state <= next_state;\n    end\n\nendmodule\n```"}}
