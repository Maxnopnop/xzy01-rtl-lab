{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule request_delay(\n    input  clk,\n    input  rst_n,\n    input  din,\n    output reg q\n);\n\n    localparam S_IDLE = 2'b00;\n    localparam S_WAIT = 2'b01;\n    localparam S_HIGH = 2'b10;\n    localparam S_COOL = 2'b11;\n\n    reg [1:0] state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state <= S_IDLE;\n            q <= 1'b0;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    q <= 1'b0;\n                    if (din)\n                        state <= S_WAIT;\n                    else\n                        state <= S_IDLE;\n                end\n                S_WAIT: begin\n                    q <= 1'b1;\n                    state <= S_HIGH;\n                end\n                S_HIGH: begin\n                    q <= 1'b0;\n                    state <= S_COOL;\n                end\n                S_COOL: begin\n                    q <= 1'b0;\n                    if (din)\n                        state <= S_COOL;\n                    else\n                        state <= S_IDLE;\n                end\n                default: begin\n                    state <= S_IDLE;\n                    q <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```"}}
