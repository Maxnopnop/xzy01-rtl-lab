{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule debounce3(\n    input  clk,\n    input  rst_n,\n    input  din,\n    output reg q\n);\n\n    localparam [2:0] S_LOW0  = 3'd0;\n    localparam [2:0] S_LOW1  = 3'd1;\n    localparam [2:0] S_LOW2  = 3'd2;\n    localparam [2:0] S_HIGH0 = 3'd3;\n    localparam [2:0] S_HIGH1 = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S_LOW0;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        next_state = state;\n        case (state)\n            S_LOW0: begin\n                if (din)\n                    next_state = S_LOW1;\n                else\n                    next_state = S_LOW0;\n            end\n            S_LOW1: begin\n                if (din)\n                    next_state = S_LOW2;\n                else\n                    next_state = S_LOW0;\n            end\n            S_LOW2: begin\n                if (din)\n                    next_state = S_HIGH0;\n                else\n                    next_state = S_LOW0;\n            end\n            S_HIGH0: begin\n                if (din)\n                    next_state = S_HIGH0;\n                else\n                    next_state = S_HIGH1;\n            end\n            S_HIGH1: begin\n                if (din)\n                    next_state = S_HIGH0;\n                else\n                    next_state = S_LOW0;\n            end\n            default: next_state = S_LOW0;\n        endcase\n    end\n\n    always @(*) begin\n        case (state)\n            S_HIGH0, S_HIGH1: q = 1'b1;\n            default:          q = 1'b0;\n        endcase\n    end\n\nendmodule\n```"}}
