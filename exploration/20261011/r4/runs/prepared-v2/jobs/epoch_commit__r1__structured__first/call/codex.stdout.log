{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule epoch_commit (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       write,\n    input  logic       slot,\n    input  logic [1:0] data,\n    input  logic       commit,\n    input  logic       abort_tx,\n    input  logic       read_slot,\n    output logic [1:0] visible,\n    output logic [1:0] dirty,\n    output logic       committed\n);\n\n    logic [1:0] live0, live1;\n    logic [1:0] staged0, staged1;\n    logic [1:0] dirty_reg;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            live0      <= 2'b00;\n            live1      <= 2'b00;\n            staged0    <= 2'b00;\n            staged1    <= 2'b00;\n            dirty_reg  <= 2'b00;\n            committed  <= 1'b0;\n        end else begin\n            committed <= 1'b0;\n\n            if (abort_tx) begin\n                staged0   <= live0;\n                staged1   <= live1;\n                dirty_reg <= 2'b00;\n            end else if (commit) begin\n                if (dirty_reg[0] || (write && !slot))\n                    live0 <= (write && !slot) ? data : staged0;\n\n                if (dirty_reg[1] || (write && slot))\n                    live1 <= (write && slot) ? data : staged1;\n\n                if (write && !slot)\n                    staged0 <= data;\n\n                if (write && slot)\n                    staged1 <= data;\n\n                dirty_reg <= 2'b00;\n                committed <= 1'b1;\n            end else if (write) begin\n                if (!slot) begin\n                    staged0     <= data;\n                    dirty_reg[0] <= 1'b1;\n                end else begin\n                    staged1     <= data;\n                    dirty_reg[1] <= 1'b1;\n                end\n            end\n        end\n    end\n\n    always_comb begin\n        visible = 2'b00;\n        if (rst_n)\n            visible = read_slot ? live1 : live0;\n    end\n\n    assign dirty = dirty_reg;\n\nendmodule\n```"}}
