{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule refund_credit (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       submit,\n    input  logic [1:0] refund,\n    input  logic [1:0] cost,\n    output logic [2:0] credit,\n    output logic       accepted,\n    output logic       rejected,\n    output logic       can_pay\n);\n\n    logic [3:0] funded;\n\n    always_comb begin\n        if ({1'b0, credit} + {2'b00, refund} > 4'd5)\n            funded = 4'd5;\n        else\n            funded = {1'b0, credit} + {2'b00, refund};\n\n        can_pay = rst_n &&\n                  (cost != 2'd0) &&\n                  (funded >= {2'b00, cost});\n    end\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            credit   <= 3'd0;\n            accepted <= 1'b0;\n            rejected <= 1'b0;\n        end else begin\n            credit   <= funded[2:0];\n            accepted <= 1'b0;\n            rejected <= 1'b0;\n\n            if (submit) begin\n                if (cost == 2'd0) begin\n                    rejected <= 1'b1;\n                end else if (funded >= {2'b00, cost}) begin\n                    credit   <= funded - {2'b00, cost};\n                    accepted <= 1'b1;\n                end else begin\n                    rejected <= 1'b1;\n                end\n            end\n        end\n    end\n\nendmodule\n```"}}
