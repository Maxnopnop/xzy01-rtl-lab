{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule refund_credit (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       submit,\n    input  logic [1:0] refund,\n    input  logic [1:0] cost,\n    output logic [2:0] credit,\n    output logic       accepted,\n    output logic       rejected,\n    output logic       can_pay\n);\n\n    logic [2:0] credit_q;\n    logic       accepted_q;\n    logic       rejected_q;\n    logic [3:0] credit_sum;\n    logic [3:0] funded;\n\n    always_comb begin\n        credit_sum = {1'b0, credit_q} + {2'b00, refund};\n        funded = (credit_sum >= 4'd5) ? 4'd5 : credit_sum;\n\n        credit   = credit_q;\n        accepted = accepted_q;\n        rejected = rejected_q;\n        can_pay  = rst_n &&\n                   (cost != 2'd0) &&\n                   (funded >= {2'b00, cost});\n    end\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            credit_q   <= 3'd0;\n            accepted_q <= 1'b0;\n            rejected_q <= 1'b0;\n        end else begin\n            credit_q   <= funded[2:0];\n            accepted_q <= 1'b0;\n            rejected_q <= 1'b0;\n\n            if (submit) begin\n                if (cost == 2'd0) begin\n                    rejected_q <= 1'b1;\n                end else if (funded >= {2'b00, cost}) begin\n                    credit_q   <= funded[2:0] - {1'b0, cost};\n                    accepted_q <= 1'b1;\n                end else begin\n                    rejected_q <= 1'b1;\n                end\n            end\n        end\n    end\n\nendmodule\n```"}}
