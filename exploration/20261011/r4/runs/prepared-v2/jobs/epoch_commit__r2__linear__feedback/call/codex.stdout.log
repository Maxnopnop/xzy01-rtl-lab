{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule epoch_commit (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       write,\n    input  logic       slot,\n    input  logic [1:0] data,\n    input  logic       commit,\n    input  logic       abort_tx,\n    input  logic       read_slot,\n    output logic [1:0] visible,\n    output logic [1:0] dirty,\n    output logic       committed\n);\n\n    logic [1:0] live0, live1;\n    logic [1:0] staged0, staged1;\n    logic [1:0] dirty_bits;\n    logic       committed_reg;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            live0         <= 2'b00;\n            live1         <= 2'b00;\n            staged0       <= 2'b00;\n            staged1       <= 2'b00;\n            dirty_bits    <= 2'b00;\n            committed_reg <= 1'b0;\n        end else if (abort_tx) begin\n            staged0       <= live0;\n            staged1       <= live1;\n            dirty_bits    <= 2'b00;\n            committed_reg <= 1'b0;\n        end else begin\n            committed_reg <= commit;\n\n            if (write) begin\n                if (slot)\n                    staged1 <= data;\n                else\n                    staged0 <= data;\n            end\n\n            if (commit) begin\n                if (dirty_bits[0] || (write && !slot))\n                    live0 <= (write && !slot) ? data : staged0;\n\n                if (dirty_bits[1] || (write && slot))\n                    live1 <= (write && slot) ? data : staged1;\n\n                dirty_bits <= 2'b00;\n            end else if (write) begin\n                if (slot)\n                    dirty_bits <= dirty_bits | 2'b10;\n                else\n                    dirty_bits <= dirty_bits | 2'b01;\n            end\n        end\n    end\n\n    always_comb begin\n        visible   = rst_n ? (read_slot ? live1 : live0) : 2'b00;\n        dirty     = dirty_bits;\n        committed = committed_reg;\n    end\n\nendmodule\n```"}}
