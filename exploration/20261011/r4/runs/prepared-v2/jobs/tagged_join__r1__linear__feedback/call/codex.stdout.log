{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule tagged_join (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       av,\n    input  logic       atag,\n    input  logic [1:0] adata,\n    input  logic       bv,\n    input  logic       btag,\n    input  logic [1:0] bdata,\n    input  logic       flush,\n    output logic       pending_a,\n    output logic       pending_b,\n    output logic       joined,\n    output logic [1:0] result\n);\n\n    logic       a_valid;\n    logic       a_tag;\n    logic [1:0] a_data;\n    logic       b_valid;\n    logic       b_tag;\n    logic [1:0] b_data;\n\n    logic       updated_a_valid;\n    logic       updated_a_tag;\n    logic [1:0] updated_a_data;\n    logic       updated_b_valid;\n    logic       updated_b_tag;\n    logic [1:0] updated_b_data;\n\n    always_comb begin\n        updated_a_valid = av ? 1'b1 : a_valid;\n        updated_a_tag   = av ? atag : a_tag;\n        updated_a_data  = av ? adata : a_data;\n\n        updated_b_valid = bv ? 1'b1 : b_valid;\n        updated_b_tag   = bv ? btag : b_tag;\n        updated_b_data  = bv ? bdata : b_data;\n    end\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            a_valid <= 1'b0;\n            a_tag   <= 1'b0;\n            a_data  <= 2'b00;\n            b_valid <= 1'b0;\n            b_tag   <= 1'b0;\n            b_data  <= 2'b00;\n            joined  <= 1'b0;\n            result  <= 2'b00;\n        end else if (flush) begin\n            a_valid <= 1'b0;\n            a_tag   <= 1'b0;\n            a_data  <= 2'b00;\n            b_valid <= 1'b0;\n            b_tag   <= 1'b0;\n            b_data  <= 2'b00;\n            joined  <= 1'b0;\n            result  <= 2'b00;\n        end else begin\n            a_tag   <= updated_a_tag;\n            a_data  <= updated_a_data;\n            b_tag   <= updated_b_tag;\n            b_data  <= updated_b_data;\n            joined  <= 1'b0;\n\n            if (updated_a_valid && updated_b_valid &&\n                (updated_a_tag == updated_b_tag)) begin\n                a_valid <= 1'b0;\n                b_valid <= 1'b0;\n                joined  <= 1'b1;\n                result  <= updated_a_data ^ updated_b_data;\n            end else begin\n                a_valid <= updated_a_valid;\n                b_valid <= updated_b_valid;\n            end\n        end\n    end\n\n    always_comb begin\n        pending_a = a_valid;\n        pending_b = b_valid;\n    end\n\nendmodule\n```"}}
