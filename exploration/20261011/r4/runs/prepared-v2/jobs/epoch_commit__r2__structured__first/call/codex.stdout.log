{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule epoch_commit (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       write,\n    input  logic       slot,\n    input  logic [1:0] data,\n    input  logic       commit,\n    input  logic       abort_tx,\n    input  logic       read_slot,\n    output logic [1:0] visible,\n    output logic [1:0] dirty,\n    output logic       committed\n);\n\n    logic [1:0] live0, live1;\n    logic [1:0] staged0, staged1;\n    logic       dirty0, dirty1;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            live0     <= 2'b00;\n            live1     <= 2'b00;\n            staged0   <= 2'b00;\n            staged1   <= 2'b00;\n            dirty0    <= 1'b0;\n            dirty1    <= 1'b0;\n            committed <= 1'b0;\n        end else begin\n            committed <= 1'b0;\n\n            if (abort_tx) begin\n                staged0 <= live0;\n                staged1 <= live1;\n                dirty0  <= 1'b0;\n                dirty1  <= 1'b0;\n            end else begin\n                if (write) begin\n                    if (slot) begin\n                        staged1 <= data;\n                        dirty1  <= 1'b1;\n                    end else begin\n                        staged0 <= data;\n                        dirty0  <= 1'b1;\n                    end\n                end\n\n                if (commit) begin\n                    if (dirty0 || (write && !slot)) begin\n                        live0   <= (write && !slot) ? data : staged0;\n                        staged0 <= (write && !slot) ? data : staged0;\n                    end\n                    if (dirty1 || (write && slot)) begin\n                        live1   <= (write && slot) ? data : staged1;\n                        staged1 <= (write && slot) ? data : staged1;\n                    end\n                    dirty0    <= 1'b0;\n                    dirty1    <= 1'b0;\n                    committed <= 1'b1;\n                end\n            end\n        end\n    end\n\n    always_comb begin\n        visible = !rst_n ? 2'b00 : (read_slot ? live1 : live0);\n        dirty   = {dirty1, dirty0};\n    end\n\nendmodule\n```"}}
