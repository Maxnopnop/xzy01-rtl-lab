{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule elastic_slot (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       in_valid,\n    input  logic       out_ready,\n    input  logic [1:0] in_data,\n    output logic       in_ready,\n    output logic       out_valid,\n    output logic [1:0] out_data\n);\n\n    logic       occupied;\n    logic [1:0] stored_data;\n\n    always_comb begin\n        if (!rst_n) begin\n            in_ready = 1'b0;\n            out_valid = 1'b0;\n            out_data = 2'b00;\n        end else begin\n            in_ready = !occupied || out_ready;\n            out_valid = occupied;\n            out_data = occupied ? stored_data : 2'b00;\n        end\n    end\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            occupied <= 1'b0;\n            stored_data <= 2'b00;\n        end else if (in_valid && in_ready) begin\n            occupied <= 1'b1;\n            stored_data <= in_data;\n        end else if (occupied && out_ready) begin\n            occupied <= 1'b0;\n            stored_data <= 2'b00;\n        end\n    end\n\nendmodule\n```"}}
