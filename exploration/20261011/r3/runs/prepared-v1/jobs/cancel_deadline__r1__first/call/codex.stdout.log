{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule cancel_deadline (\n    input  logic clk,\n    input  logic rst_n,\n    input  logic req,\n    input  logic cancel,\n    input  logic finish,\n    output logic busy,\n    output logic accepted,\n    output logic completed,\n    output logic cancelled,\n    output logic expired\n);\n\n    logic [1:0] remaining;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            busy      <= 1'b0;\n            remaining <= 2'd0;\n            accepted  <= 1'b0;\n            completed <= 1'b0;\n            cancelled <= 1'b0;\n            expired   <= 1'b0;\n        end else begin\n            accepted  <= 1'b0;\n            completed <= 1'b0;\n            cancelled <= 1'b0;\n            expired   <= 1'b0;\n\n            if (!busy) begin\n                if (req) begin\n                    busy      <= 1'b1;\n                    remaining <= 2'd3;\n                    accepted  <= 1'b1;\n                end\n            end else if (cancel) begin\n                busy      <= 1'b0;\n                remaining <= 2'd0;\n                cancelled <= 1'b1;\n            end else if (finish) begin\n                busy      <= 1'b0;\n                remaining <= 2'd0;\n                completed <= 1'b1;\n            end else if (remaining == 2'd1) begin\n                busy      <= 1'b0;\n                remaining <= 2'd0;\n                expired   <= 1'b1;\n            end else begin\n                remaining <= remaining - 2'd1;\n            end\n        end\n    end\n\nendmodule\n```"}}
