{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule retrigger_window (\n    input  logic       clk,\n    input  logic       rst_n,\n    input  logic       trigger,\n    input  logic       tick,\n    input  logic       enable,\n    input  logic [1:0] length,\n    output logic       active,\n    output logic [1:0] remaining,\n    output logic       expired\n);\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            active    <= 1'b0;\n            remaining <= 2'b00;\n            expired   <= 1'b0;\n        end else begin\n            expired <= 1'b0;\n\n            if (trigger) begin\n                active    <= 1'b1;\n                remaining <= (length == 2'b00) ? 2'b01 : length;\n            end else if (active && enable && tick) begin\n                if (remaining == 2'b01) begin\n                    active    <= 1'b0;\n                    remaining <= 2'b00;\n                    expired   <= 1'b1;\n                end else begin\n                    remaining <= remaining - 2'b01;\n                end\n            end\n        end\n    end\n\nendmodule\n```"}}
