{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```verilog\nmodule escape_frame (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       feed,\n    input  wire [1:0] symbol,\n    input  wire       flush,\n    output reg        active,\n    output reg        escaped,\n    output reg  [1:0] work_sum,\n    output reg  [1:0] work_count,\n    output reg  [1:0] last_sum,\n    output reg  [1:0] last_count,\n    output reg        completed\n);\n\n    localparam [1:0] START = 2'd0;\n    localparam [1:0] END   = 2'd1;\n    localparam [1:0] ESC   = 2'd2;\n    localparam [1:0] DATA  = 2'd3;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            active     <= 1'b0;\n            escaped    <= 1'b0;\n            work_sum   <= 2'b00;\n            work_count <= 2'b00;\n            last_sum   <= 2'b00;\n            last_count <= 2'b00;\n            completed  <= 1'b0;\n        end else begin\n            completed <= 1'b0;\n\n            if (flush) begin\n                active     <= 1'b0;\n                escaped    <= 1'b0;\n                work_sum   <= 2'b00;\n                work_count <= 2'b00;\n            end else if (feed) begin\n                if (!active) begin\n                    if (symbol == START) begin\n                        active     <= 1'b1;\n                        escaped    <= 1'b0;\n                        work_sum   <= 2'b00;\n                        work_count <= 2'b00;\n                    end\n                end else if (escaped) begin\n                    work_sum   <= work_sum ^ symbol;\n                    work_count <= work_count + 2'd1;\n                    escaped    <= 1'b0;\n                end else begin\n                    case (symbol)\n                        START: begin\n                            work_sum   <= 2'b00;\n                            work_count <= 2'b00;\n                            escaped    <= 1'b0;\n                        end\n\n                        END: begin\n                            last_sum   <= work_sum;\n                            last_count <= work_count;\n                            completed  <= 1'b1;\n                            active     <= 1'b0;\n                            escaped    <= 1'b0;\n                            work_sum   <= 2'b00;\n                            work_count <= 2'b00;\n                        end\n\n                        ESC: begin\n                            escaped <= 1'b1;\n                        end\n\n                        DATA: begin\n                            work_sum   <= work_sum ^ DATA;\n                            work_count <= work_count + 2'd1;\n                        end\n\n                        default: begin\n                        end\n                    endcase\n                end\n            end\n        end\n    end\n\nendmodule\n```"}}
