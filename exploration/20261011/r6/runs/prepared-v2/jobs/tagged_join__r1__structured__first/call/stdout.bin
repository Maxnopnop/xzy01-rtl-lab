{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```verilog\nmodule tagged_join (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       clear,\n    input  wire       a_valid,\n    input  wire [1:0] a_tag,\n    input  wire [1:0] a_data,\n    input  wire       b_valid,\n    input  wire [1:0] b_tag,\n    input  wire [1:0] b_data,\n    input  wire       take,\n    output reg        a_full,\n    output reg        b_full,\n    output reg        out_valid,\n    output reg  [1:0] out_tag,\n    output reg  [3:0] out_data\n);\n\n    reg [1:0] a_tag_hold;\n    reg [1:0] a_data_hold;\n    reg [1:0] b_tag_hold;\n    reg [1:0] b_data_hold;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            a_full      <= 1'b0;\n            a_tag_hold  <= 2'b00;\n            a_data_hold <= 2'b00;\n            b_full      <= 1'b0;\n            b_tag_hold  <= 2'b00;\n            b_data_hold <= 2'b00;\n            out_valid   <= 1'b0;\n            out_tag     <= 2'b00;\n            out_data    <= 4'b0000;\n        end else if (clear) begin\n            a_full      <= 1'b0;\n            a_tag_hold  <= 2'b00;\n            a_data_hold <= 2'b00;\n            b_full      <= 1'b0;\n            b_tag_hold  <= 2'b00;\n            b_data_hold <= 2'b00;\n            out_valid   <= 1'b0;\n            out_tag     <= 2'b00;\n            out_data    <= 4'b0000;\n        end else begin\n            if (!a_full) begin\n                if (a_valid) begin\n                    a_full      <= 1'b1;\n                    a_tag_hold  <= a_tag;\n                    a_data_hold <= a_data;\n                end\n            end else if (b_full) begin\n                if (a_tag_hold < b_tag_hold)\n                    a_full <= 1'b0;\n                else if ((a_tag_hold == b_tag_hold) &&\n                         (!out_valid || take))\n                    a_full <= 1'b0;\n            end\n\n            if (!b_full) begin\n                if (b_valid) begin\n                    b_full      <= 1'b1;\n                    b_tag_hold  <= b_tag;\n                    b_data_hold <= b_data;\n                end\n            end else if (a_full) begin\n                if (b_tag_hold < a_tag_hold)\n                    b_full <= 1'b0;\n                else if ((a_tag_hold == b_tag_hold) &&\n                         (!out_valid || take))\n                    b_full <= 1'b0;\n            end\n\n            if (a_full && b_full &&\n                (a_tag_hold == b_tag_hold) &&\n                (!out_valid || take)) begin\n                out_valid <= 1'b1;\n                out_tag   <= a_tag_hold;\n                out_data  <= {a_data_hold, b_data_hold};\n            end else if (take) begin\n                out_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```"}}
