{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module restoring_divide (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       abort,\n    input  wire       start,\n    input  wire       advance,\n    input  wire [3:0] numerator,\n    input  wire [3:0] denominator,\n    output reg        busy,\n    output reg        done,\n    output reg  [3:0] quotient,\n    output reg  [3:0] remainder\n);\n\n    reg [3:0] denominator_latched;\n    reg [3:0] numerator_shift;\n    reg [3:0] quotient_work;\n    reg [3:0] remainder_work;\n    reg [1:0] advance_count;\n\n    wire [4:0] trial_remainder;\n    wire       quotient_bit;\n    wire [4:0] reduced_remainder;\n    wire [3:0] quotient_next;\n\n    assign trial_remainder =\n        {remainder_work, numerator_shift[3]};\n\n    assign quotient_bit =\n        (trial_remainder >= {1'b0, denominator_latched});\n\n    assign reduced_remainder =\n        quotient_bit\n            ? trial_remainder - {1'b0, denominator_latched}\n            : trial_remainder;\n\n    assign quotient_next = {quotient_work[2:0], quotient_bit};\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            busy                <= 1'b0;\n            done                <= 1'b0;\n            quotient            <= 4'b0000;\n            remainder           <= 4'b0000;\n            denominator_latched <= 4'b0000;\n            numerator_shift     <= 4'b0000;\n            quotient_work       <= 4'b0000;\n            remainder_work      <= 4'b0000;\n            advance_count       <= 2'b00;\n        end else if (abort) begin\n            busy                <= 1'b0;\n            done                <= 1'b0;\n            quotient            <= 4'b0000;\n            remainder           <= 4'b0000;\n            denominator_latched <= 4'b0000;\n            numerator_shift     <= 4'b0000;\n            quotient_work       <= 4'b0000;\n            remainder_work      <= 4'b0000;\n            advance_count       <= 2'b00;\n        end else begin\n            done <= 1'b0;\n\n            if (busy) begin\n                if (advance) begin\n                    numerator_shift <= {numerator_shift[2:0], 1'b0};\n                    quotient_work   <= quotient_next;\n                    remainder_work  <= reduced_remainder[3:0];\n\n                    if (advance_count == 2'd3) begin\n                        busy          <= 1'b0;\n                        done          <= 1'b1;\n                        quotient      <= quotient_next;\n                        remainder     <= reduced_remainder[3:0];\n                        advance_count <= 2'b00;\n                    end else begin\n                        advance_count <= advance_count + 1'b1;\n                    end\n                end\n            end else if (start) begin\n                if (denominator == 4'b0000) begin\n                    busy      <= 1'b0;\n                    done      <= 1'b1;\n                    quotient  <= 4'b1111;\n                    remainder <= numerator;\n                end else begin\n                    busy                <= 1'b1;\n                    denominator_latched <= denominator;\n                    numerator_shift     <= numerator;\n                    quotient_work       <= 4'b0000;\n                    remainder_work      <= 4'b0000;\n                    advance_count       <= 2'b00;\n                end\n            end\n        end\n    end\n\nendmodule"}}
