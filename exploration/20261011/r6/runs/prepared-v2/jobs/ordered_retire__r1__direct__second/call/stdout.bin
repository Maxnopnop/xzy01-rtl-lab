{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module ordered_retire (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       flush,\n    input  wire       issue,\n    input  wire [1:0] issue_tag,\n    input  wire       finish,\n    input  wire [1:0] finish_tag,\n    output reg  [1:0] count,\n    output reg        retired,\n    output reg  [1:0] retired_tag\n);\n\n    reg       valid0, valid1;\n    reg       finished0, finished1;\n    reg [1:0] tag0, tag1;\n\n    reg       next_valid0, next_valid1;\n    reg       next_finished0, next_finished1;\n    reg [1:0] next_tag0, next_tag1;\n    reg [1:0] next_count;\n    reg       next_retired;\n    reg [1:0] next_retired_tag;\n\n    reg accept_issue;\n    reg retire_head;\n\n    always @* begin\n        next_valid0       = valid0;\n        next_valid1       = valid1;\n        next_finished0    = finished0;\n        next_finished1    = finished1;\n        next_tag0         = tag0;\n        next_tag1         = tag1;\n        next_count        = count;\n        next_retired      = 1'b0;\n        next_retired_tag  = retired_tag;\n\n        retire_head = valid0 && finished0;\n\n        accept_issue = issue &&\n                       (count < 2) &&\n                       !(valid0 && (tag0 == issue_tag)) &&\n                       !(valid1 && (tag1 == issue_tag));\n\n        if (finish && valid0 && (finish_tag == tag0))\n            next_finished0 = 1'b1;\n\n        if (finish && valid1 && (finish_tag == tag1))\n            next_finished1 = 1'b1;\n\n        if (retire_head) begin\n            next_retired     = 1'b1;\n            next_retired_tag = tag0;\n\n            next_valid0      = valid1;\n            next_tag0        = tag1;\n            next_finished0   = next_finished1;\n\n            next_valid1      = 1'b0;\n            next_tag1        = 2'b00;\n            next_finished1   = 1'b0;\n\n            next_count       = count - 1'b1;\n        end\n\n        if (accept_issue) begin\n            if (retire_head || !valid0) begin\n                next_valid0     = 1'b1;\n                next_tag0       = issue_tag;\n                next_finished0  = 1'b0;\n            end else begin\n                next_valid1     = 1'b1;\n                next_tag1       = issue_tag;\n                next_finished1  = 1'b0;\n            end\n\n            next_count = next_count + 1'b1;\n        end\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            valid0       <= 1'b0;\n            valid1       <= 1'b0;\n            finished0    <= 1'b0;\n            finished1    <= 1'b0;\n            tag0         <= 2'b00;\n            tag1         <= 2'b00;\n            count        <= 2'b00;\n            retired      <= 1'b0;\n            retired_tag  <= 2'b00;\n        end else if (flush) begin\n            valid0       <= 1'b0;\n            valid1       <= 1'b0;\n            finished0    <= 1'b0;\n            finished1    <= 1'b0;\n            tag0         <= 2'b00;\n            tag1         <= 2'b00;\n            count        <= 2'b00;\n            retired      <= 1'b0;\n            retired_tag  <= 2'b00;\n        end else begin\n            valid0       <= next_valid0;\n            valid1       <= next_valid1;\n            finished0    <= next_finished0;\n            finished1    <= next_finished1;\n            tag0         <= next_tag0;\n            tag1         <= next_tag1;\n            count        <= next_count;\n            retired      <= next_retired;\n            retired_tag  <= next_retired_tag;\n        end\n    end\n\nendmodule"}}
