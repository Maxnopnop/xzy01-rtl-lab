{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module ordered_retire (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       flush,\n    input  wire       issue,\n    input  wire [1:0] issue_tag,\n    input  wire       finish,\n    input  wire [1:0] finish_tag,\n    output reg  [1:0] count,\n    output reg        retired,\n    output reg  [1:0] retired_tag\n);\n\n    reg       valid0, valid1;\n    reg       finished0, finished1;\n    reg [1:0] tag0, tag1;\n\n    reg       n_valid0, n_valid1;\n    reg       n_finished0, n_finished1;\n    reg [1:0] n_tag0, n_tag1;\n    reg [1:0] n_count;\n    reg       n_retired;\n    reg [1:0] n_retired_tag;\n\n    reg retire_old_head;\n    reg accept_old_issue;\n\n    always @* begin\n        n_valid0      = valid0;\n        n_valid1      = valid1;\n        n_finished0   = finished0;\n        n_finished1   = finished1;\n        n_tag0        = tag0;\n        n_tag1        = tag1;\n        n_count       = count;\n        n_retired     = 1'b0;\n        n_retired_tag = retired_tag;\n\n        retire_old_head = valid0 && finished0;\n\n        accept_old_issue =\n            issue &&\n            (count < 2) &&\n            !(valid0 && (tag0 == issue_tag)) &&\n            !(valid1 && (tag1 == issue_tag));\n\n        if (finish && valid0 && (finish_tag == tag0))\n            n_finished0 = 1'b1;\n\n        if (finish && valid1 && (finish_tag == tag1))\n            n_finished1 = 1'b1;\n\n        if (retire_old_head) begin\n            n_retired     = 1'b1;\n            n_retired_tag = tag0;\n\n            n_valid0      = valid1;\n            n_finished0   = n_finished1;\n            n_tag0        = tag1;\n\n            n_valid1      = 1'b0;\n            n_finished1   = 1'b0;\n            n_tag1        = 2'b00;\n\n            n_count       = count - 2'b01;\n        end\n\n        if (accept_old_issue) begin\n            if (retire_old_head || !valid0) begin\n                n_valid0    = 1'b1;\n                n_finished0 = 1'b0;\n                n_tag0      = issue_tag;\n            end else begin\n                n_valid1    = 1'b1;\n                n_finished1 = 1'b0;\n                n_tag1      = issue_tag;\n            end\n\n            n_count = n_count + 2'b01;\n        end\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            valid0      <= 1'b0;\n            valid1      <= 1'b0;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n            tag0        <= 2'b00;\n            tag1        <= 2'b00;\n            count       <= 2'b00;\n            retired     <= 1'b0;\n            retired_tag <= 2'b00;\n        end else if (flush) begin\n            valid0      <= 1'b0;\n            valid1      <= 1'b0;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n            tag0        <= 2'b00;\n            tag1        <= 2'b00;\n            count       <= 2'b00;\n            retired     <= 1'b0;\n            retired_tag <= 2'b00;\n        end else begin\n            valid0      <= n_valid0;\n            valid1      <= n_valid1;\n            finished0   <= n_finished0;\n            finished1   <= n_finished1;\n            tag0        <= n_tag0;\n            tag1        <= n_tag1;\n            count       <= n_count;\n            retired     <= n_retired;\n            retired_tag <= n_retired_tag;\n        end\n    end\n\nendmodule"}}
