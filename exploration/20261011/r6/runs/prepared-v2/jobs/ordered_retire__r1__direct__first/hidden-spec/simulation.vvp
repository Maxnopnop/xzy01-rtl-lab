    %store/vec4 v0000015ef2d8fa50_0, 0, 32;
    %vpi_call/w 3 7 "$fdisplay", v0000015ef2d8fa50_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0000015ef2d90d80_0, v0000015ef2d8f910_0, v0000015ef2d8f230_0 {0 0 0};
    %vpi_call/w 3 7 "$fclose", v0000015ef2d8fa50_0 {0 0 0};
    %vpi_call/w 3 7 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "dut.sv";
