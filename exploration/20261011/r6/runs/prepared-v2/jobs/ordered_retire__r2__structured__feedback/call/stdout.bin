{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module ordered_retire (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       flush,\n    input  wire       issue,\n    input  wire [1:0] issue_tag,\n    input  wire       finish,\n    input  wire [1:0] finish_tag,\n    output reg  [1:0] count,\n    output reg        retired,\n    output reg  [1:0] retired_tag\n);\n\n    reg [1:0] tag0, tag1;\n    reg       finished0, finished1;\n\n    wire retire_old;\n    wire issue_accept;\n\n    assign retire_old = (count != 2'd0) && finished0;\n\n    assign issue_accept =\n        issue &&\n        (count < 2'd2) &&\n        ((count == 2'd0) || (issue_tag != tag0)) &&\n        ((count <  2'd2) || (issue_tag != tag1));\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            count       <= 2'd0;\n            tag0        <= 2'd0;\n            tag1        <= 2'd0;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n            retired     <= 1'b0;\n            retired_tag <= 2'd0;\n        end else if (flush) begin\n            count       <= 2'd0;\n            tag0        <= 2'd0;\n            tag1        <= 2'd0;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n            retired     <= 1'b0;\n            retired_tag <= 2'd0;\n        end else begin\n            retired <= retire_old;\n\n            if (retire_old)\n                retired_tag <= tag0;\n\n            case (count)\n                2'd0: begin\n                    if (issue_accept) begin\n                        count     <= 2'd1;\n                        tag0      <= issue_tag;\n                        finished0 <= 1'b0;\n                    end\n                end\n\n                2'd1: begin\n                    if (retire_old) begin\n                        if (issue_accept) begin\n                            count     <= 2'd1;\n                            tag0      <= issue_tag;\n                            finished0 <= 1'b0;\n                        end else begin\n                            count     <= 2'd0;\n                            tag0      <= 2'd0;\n                            finished0 <= 1'b0;\n                        end\n                        tag1      <= 2'd0;\n                        finished1 <= 1'b0;\n                    end else begin\n                        if (finish && (finish_tag == tag0))\n                            finished0 <= 1'b1;\n\n                        if (issue_accept) begin\n                            count     <= 2'd2;\n                            tag1      <= issue_tag;\n                            finished1 <= 1'b0;\n                        end\n                    end\n                end\n\n                2'd2: begin\n                    if (retire_old) begin\n                        count     <= 2'd1;\n                        tag0      <= tag1;\n                        finished0 <= finished1 ||\n                                     (finish && (finish_tag == tag1));\n                        tag1      <= 2'd0;\n                        finished1 <= 1'b0;\n                    end else begin\n                        if (finish && (finish_tag == tag0))\n                            finished0 <= 1'b1;\n                        if (finish && (finish_tag == tag1))\n                            finished1 <= 1'b1;\n                    end\n                end\n\n                default: begin\n                    count     <= 2'd0;\n                    tag0      <= 2'd0;\n                    tag1      <= 2'd0;\n                    finished0 <= 1'b0;\n                    finished1 <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule"}}
