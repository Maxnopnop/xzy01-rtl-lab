{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module ordered_retire (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       flush,\n    input  wire       issue,\n    input  wire [1:0] issue_tag,\n    input  wire       finish,\n    input  wire [1:0] finish_tag,\n    output reg  [1:0] count,\n    output reg        retired,\n    output reg  [1:0] retired_tag\n);\n\n    reg [1:0] head_tag;\n    reg [1:0] tail_tag;\n    reg       head_finished;\n    reg       tail_finished;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            count         <= 2'd0;\n            retired       <= 1'b0;\n            retired_tag   <= 2'd0;\n            head_tag      <= 2'd0;\n            tail_tag      <= 2'd0;\n            head_finished <= 1'b0;\n            tail_finished <= 1'b0;\n        end else if (flush) begin\n            count         <= 2'd0;\n            retired       <= 1'b0;\n            retired_tag   <= 2'd0;\n            head_tag      <= 2'd0;\n            tail_tag      <= 2'd0;\n            head_finished <= 1'b0;\n            tail_finished <= 1'b0;\n        end else begin\n            retired <= 1'b0;\n\n            case (count)\n                2'd0: begin\n                    head_finished <= 1'b0;\n                    tail_finished <= 1'b0;\n\n                    if (issue) begin\n                        head_tag <= issue_tag;\n                        count    <= 2'd1;\n                    end\n                end\n\n                2'd1: begin\n                    tail_finished <= 1'b0;\n\n                    if (head_finished) begin\n                        retired     <= 1'b1;\n                        retired_tag <= head_tag;\n\n                        if (issue && (issue_tag != head_tag)) begin\n                            head_tag      <= issue_tag;\n                            head_finished <= 1'b0;\n                            count         <= 2'd1;\n                        end else begin\n                            head_finished <= 1'b0;\n                            count         <= 2'd0;\n                        end\n                    end else begin\n                        if (finish && (finish_tag == head_tag))\n                            head_finished <= 1'b1;\n\n                        if (issue && (issue_tag != head_tag)) begin\n                            tail_tag      <= issue_tag;\n                            tail_finished <= 1'b0;\n                            count         <= 2'd2;\n                        end\n                    end\n                end\n\n                2'd2: begin\n                    if (head_finished) begin\n                        retired       <= 1'b1;\n                        retired_tag   <= head_tag;\n                        head_tag      <= tail_tag;\n                        head_finished <= tail_finished |\n                                         (finish && (finish_tag == tail_tag));\n                        tail_finished <= 1'b0;\n                        count         <= 2'd1;\n                    end else begin\n                        if (finish && (finish_tag == head_tag))\n                            head_finished <= 1'b1;\n\n                        if (finish && (finish_tag == tail_tag))\n                            tail_finished <= 1'b1;\n                    end\n                end\n\n                default: begin\n                    count         <= 2'd0;\n                    retired       <= 1'b0;\n                    retired_tag   <= 2'd0;\n                    head_tag      <= 2'd0;\n                    tail_tag      <= 2'd0;\n                    head_finished <= 1'b0;\n                    tail_finished <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule"}}
