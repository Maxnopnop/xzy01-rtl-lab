{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```verilog\nmodule restoring_divide (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       abort,\n    input  wire       start,\n    input  wire       advance,\n    input  wire [3:0] numerator,\n    input  wire [3:0] denominator,\n    output reg        busy,\n    output reg        done,\n    output reg  [3:0] quotient,\n    output reg  [3:0] remainder\n);\n\n    reg [3:0] den_reg;\n    reg [3:0] num_work;\n    reg [3:0] quot_work;\n    reg [3:0] rem_work;\n    reg [2:0] count;\n\n    wire [4:0] trial;\n    wire       subtract;\n    wire [4:0] next_rem;\n    wire [3:0] next_quot;\n\n    assign trial     = {rem_work, num_work[3]};\n    assign subtract  = (trial >= {1'b0, den_reg});\n    assign next_rem  = subtract ? (trial - {1'b0, den_reg}) : trial;\n    assign next_quot = {quot_work[2:0], subtract};\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            busy      <= 1'b0;\n            done      <= 1'b0;\n            quotient  <= 4'b0000;\n            remainder <= 4'b0000;\n            den_reg   <= 4'b0000;\n            num_work  <= 4'b0000;\n            quot_work <= 4'b0000;\n            rem_work  <= 4'b0000;\n            count     <= 3'b000;\n        end else if (abort) begin\n            busy      <= 1'b0;\n            done      <= 1'b0;\n            quotient  <= 4'b0000;\n            remainder <= 4'b0000;\n            den_reg   <= 4'b0000;\n            num_work  <= 4'b0000;\n            quot_work <= 4'b0000;\n            rem_work  <= 4'b0000;\n            count     <= 3'b000;\n        end else begin\n            done <= 1'b0;\n\n            if (!busy) begin\n                if (start) begin\n                    if (denominator == 4'b0000) begin\n                        busy      <= 1'b0;\n                        done      <= 1'b1;\n                        quotient  <= 4'b1111;\n                        remainder <= numerator;\n                    end else begin\n                        busy      <= 1'b1;\n                        den_reg   <= denominator;\n                        num_work  <= numerator;\n                        quot_work <= 4'b0000;\n                        rem_work  <= 4'b0000;\n                        count     <= 3'b000;\n                    end\n                end\n            end else if (advance) begin\n                num_work  <= {num_work[2:0], 1'b0};\n                quot_work <= next_quot;\n                rem_work  <= next_rem[3:0];\n\n                if (count == 3) begin\n                    busy      <= 1'b0;\n                    done      <= 1'b1;\n                    quotient  <= next_quot;\n                    remainder <= next_rem[3:0];\n                    count     <= 3'b000;\n                end else begin\n                    count <= count + 1'b1;\n                end\n            end\n        end\n    end\n\nendmodule\n```"}}
