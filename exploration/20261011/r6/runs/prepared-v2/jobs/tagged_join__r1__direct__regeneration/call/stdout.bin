{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module tagged_join (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       clear,\n    input  wire       a_valid,\n    input  wire [1:0] a_tag,\n    input  wire [1:0] a_data,\n    input  wire       b_valid,\n    input  wire [1:0] b_tag,\n    input  wire [1:0] b_data,\n    input  wire       take,\n    output reg        a_full,\n    output reg        b_full,\n    output reg        out_valid,\n    output reg  [1:0] out_tag,\n    output reg  [3:0] out_data\n);\n\n    reg [1:0] a_tag_slot;\n    reg [1:0] a_data_slot;\n    reg [1:0] b_tag_slot;\n    reg [1:0] b_data_slot;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            a_full      <= 1'b0;\n            b_full      <= 1'b0;\n            a_tag_slot  <= 2'b00;\n            a_data_slot <= 2'b00;\n            b_tag_slot  <= 2'b00;\n            b_data_slot <= 2'b00;\n            out_valid   <= 1'b0;\n            out_tag     <= 2'b00;\n            out_data    <= 4'b0000;\n        end else if (clear) begin\n            a_full      <= 1'b0;\n            b_full      <= 1'b0;\n            a_tag_slot  <= 2'b00;\n            a_data_slot <= 2'b00;\n            b_tag_slot  <= 2'b00;\n            b_data_slot <= 2'b00;\n            out_valid   <= 1'b0;\n            out_tag     <= 2'b00;\n            out_data    <= 4'b0000;\n        end else begin\n            if (a_valid && !a_full) begin\n                a_full      <= 1'b1;\n                a_tag_slot  <= a_tag;\n                a_data_slot <= a_data;\n            end\n\n            if (b_valid && !b_full) begin\n                b_full      <= 1'b1;\n                b_tag_slot  <= b_tag;\n                b_data_slot <= b_data;\n            end\n\n            if (a_full && b_full) begin\n                if (a_tag_slot < b_tag_slot) begin\n                    a_full <= 1'b0;\n                    if (take)\n                        out_valid <= 1'b0;\n                end else if (a_tag_slot > b_tag_slot) begin\n                    b_full <= 1'b0;\n                    if (take)\n                        out_valid <= 1'b0;\n                end else if (!out_valid || take) begin\n                    a_full   <= 1'b0;\n                    b_full   <= 1'b0;\n                    out_valid <= 1'b1;\n                    out_tag   <= a_tag_slot;\n                    out_data  <= {a_data_slot, b_data_slot};\n                end\n            end else if (take) begin\n                out_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule"}}
