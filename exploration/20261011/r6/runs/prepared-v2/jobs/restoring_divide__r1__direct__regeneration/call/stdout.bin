{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module restoring_divide (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       abort,\n    input  wire       start,\n    input  wire       advance,\n    input  wire [3:0] numerator,\n    input  wire [3:0] denominator,\n    output reg        busy,\n    output reg        done,\n    output reg  [3:0] quotient,\n    output reg  [3:0] remainder\n);\n\n    reg [3:0] numerator_work;\n    reg [3:0] denominator_work;\n    reg [3:0] quotient_work;\n    reg [3:0] remainder_work;\n    reg [1:0] advance_count;\n\n    wire [4:0] trial_remainder;\n    wire       subtract;\n    wire [4:0] next_remainder;\n    wire [3:0] next_quotient;\n\n    assign trial_remainder = {remainder_work, numerator_work[3]};\n    assign subtract = trial_remainder >= {1'b0, denominator_work};\n    assign next_remainder = subtract\n                          ? trial_remainder - {1'b0, denominator_work}\n                          : trial_remainder;\n    assign next_quotient = {quotient_work[2:0], subtract};\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            busy             <= 1'b0;\n            done             <= 1'b0;\n            quotient         <= 4'b0000;\n            remainder        <= 4'b0000;\n            numerator_work   <= 4'b0000;\n            denominator_work <= 4'b0000;\n            quotient_work    <= 4'b0000;\n            remainder_work   <= 4'b0000;\n            advance_count    <= 2'b00;\n        end else if (abort) begin\n            busy             <= 1'b0;\n            done             <= 1'b0;\n            quotient         <= 4'b0000;\n            remainder        <= 4'b0000;\n            numerator_work   <= 4'b0000;\n            denominator_work <= 4'b0000;\n            quotient_work    <= 4'b0000;\n            remainder_work   <= 4'b0000;\n            advance_count    <= 2'b00;\n        end else begin\n            done <= 1'b0;\n\n            if (!busy) begin\n                if (start) begin\n                    if (denominator == 4'b0000) begin\n                        busy      <= 1'b0;\n                        done      <= 1'b1;\n                        quotient  <= 4'b1111;\n                        remainder <= numerator;\n                    end else begin\n                        busy             <= 1'b1;\n                        numerator_work   <= numerator;\n                        denominator_work <= denominator;\n                        quotient_work    <= 4'b0000;\n                        remainder_work   <= 4'b0000;\n                        advance_count    <= 2'b00;\n                    end\n                end\n            end else if (advance) begin\n                numerator_work <= {numerator_work[2:0], 1'b0};\n                quotient_work  <= next_quotient;\n                remainder_work <= next_remainder[3:0];\n\n                if (advance_count == 2'd3) begin\n                    busy          <= 1'b0;\n                    done          <= 1'b1;\n                    quotient      <= next_quotient;\n                    remainder     <= next_remainder[3:0];\n                    advance_count <= 2'b00;\n                end else begin\n                    advance_count <= advance_count + 2'd1;\n                end\n            end\n        end\n    end\n\nendmodule"}}
