{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module restoring_divide (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       abort,\n    input  wire       start,\n    input  wire       advance,\n    input  wire [3:0] numerator,\n    input  wire [3:0] denominator,\n    output reg        busy,\n    output reg        done,\n    output reg  [3:0] quotient,\n    output reg  [3:0] remainder\n);\n\n    reg [3:0] divisor_r;\n    reg [3:0] dividend_r;\n    reg [4:0] partial_r;\n    reg [3:0] quotient_work_r;\n    reg [1:0] count_r;\n\n    wire [4:0] trial;\n    wire       trial_ge_divisor;\n    wire [4:0] partial_next;\n    wire [3:0] quotient_next;\n\n    assign trial = {partial_r[3:0], dividend_r[3]};\n    assign trial_ge_divisor = (trial >= {1'b0, divisor_r});\n    assign partial_next = trial_ge_divisor\n                        ? trial - {1'b0, divisor_r}\n                        : trial;\n    assign quotient_next = {quotient_work_r[2:0], trial_ge_divisor};\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            busy            <= 1'b0;\n            done            <= 1'b0;\n            quotient        <= 4'b0000;\n            remainder       <= 4'b0000;\n            divisor_r       <= 4'b0000;\n            dividend_r      <= 4'b0000;\n            partial_r       <= 5'b00000;\n            quotient_work_r <= 4'b0000;\n            count_r         <= 2'b00;\n        end else if (abort) begin\n            busy            <= 1'b0;\n            done            <= 1'b0;\n            quotient        <= 4'b0000;\n            remainder       <= 4'b0000;\n            divisor_r       <= 4'b0000;\n            dividend_r      <= 4'b0000;\n            partial_r       <= 5'b00000;\n            quotient_work_r <= 4'b0000;\n            count_r         <= 2'b00;\n        end else begin\n            done <= 1'b0;\n\n            if (!busy) begin\n                if (start) begin\n                    if (denominator == 4'b0000) begin\n                        busy      <= 1'b0;\n                        done      <= 1'b1;\n                        quotient  <= 4'b1111;\n                        remainder <= numerator;\n                    end else begin\n                        busy            <= 1'b1;\n                        divisor_r       <= denominator;\n                        dividend_r      <= numerator;\n                        partial_r       <= 5'b00000;\n                        quotient_work_r <= 4'b0000;\n                        count_r         <= 2'b00;\n                    end\n                end\n            end else if (advance) begin\n                dividend_r      <= {dividend_r[2:0], 1'b0};\n                partial_r       <= partial_next;\n                quotient_work_r <= quotient_next;\n\n                if (count_r == 2'd3) begin\n                    busy      <= 1'b0;\n                    done      <= 1'b1;\n                    quotient  <= quotient_next;\n                    remainder <= partial_next[3:0];\n                    count_r   <= 2'b00;\n                end else begin\n                    count_r <= count_r + 2'd1;\n                end\n            end\n        end\n    end\n\nendmodule"}}
