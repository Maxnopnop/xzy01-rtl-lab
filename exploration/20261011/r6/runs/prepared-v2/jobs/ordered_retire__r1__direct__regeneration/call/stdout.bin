{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"module ordered_retire (\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       flush,\n    input  wire       issue,\n    input  wire [1:0] issue_tag,\n    input  wire       finish,\n    input  wire [1:0] finish_tag,\n    output reg  [1:0] count,\n    output reg        retired,\n    output reg  [1:0] retired_tag\n);\n\n    reg [1:0] tag0, tag1;\n    reg       finished0, finished1;\n\n    reg [1:0] next_count;\n    reg [1:0] next_tag0, next_tag1;\n    reg       next_finished0, next_finished1;\n    reg       next_retired;\n    reg [1:0] next_retired_tag;\n\n    reg retire_old_head;\n    reg accept_old_issue;\n\n    always @* begin\n        next_count        = count;\n        next_tag0         = tag0;\n        next_tag1         = tag1;\n        next_finished0    = finished0;\n        next_finished1    = finished1;\n        next_retired      = 1'b0;\n        next_retired_tag  = retired_tag;\n\n        retire_old_head = (count != 2'b00) && finished0;\n\n        accept_old_issue =\n            issue &&\n            (count < 2) &&\n            !((count >= 1) && (issue_tag == tag0)) &&\n            !((count >= 2) && (issue_tag == tag1));\n\n        if (finish) begin\n            if ((count >= 1) && (finish_tag == tag0))\n                next_finished0 = 1'b1;\n            if ((count >= 2) && (finish_tag == tag1))\n                next_finished1 = 1'b1;\n        end\n\n        if (retire_old_head) begin\n            next_retired     = 1'b1;\n            next_retired_tag = tag0;\n\n            if (count == 2) begin\n                next_tag0      = tag1;\n                next_finished0 = next_finished1;\n                next_tag1      = 2'b00;\n                next_finished1 = 1'b0;\n                next_count     = 2'b01;\n            end else begin\n                next_tag0      = 2'b00;\n                next_finished0 = 1'b0;\n                next_tag1      = 2'b00;\n                next_finished1 = 1'b0;\n                next_count     = 2'b00;\n            end\n        end\n\n        if (accept_old_issue) begin\n            if (next_count == 0) begin\n                next_tag0      = issue_tag;\n                next_finished0 = 1'b0;\n            end else begin\n                next_tag1      = issue_tag;\n                next_finished1 = 1'b0;\n            end\n            next_count = next_count + 1'b1;\n        end\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            count       <= 2'b00;\n            retired     <= 1'b0;\n            retired_tag <= 2'b00;\n            tag0        <= 2'b00;\n            tag1        <= 2'b00;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n        end else if (flush) begin\n            count       <= 2'b00;\n            retired     <= 1'b0;\n            retired_tag <= 2'b00;\n            tag0        <= 2'b00;\n            tag1        <= 2'b00;\n            finished0   <= 1'b0;\n            finished1   <= 1'b0;\n        end else begin\n            count       <= next_count;\n            retired     <= next_retired;\n            retired_tag <= next_retired_tag;\n            tag0        <= next_tag0;\n            tag1        <= next_tag1;\n            finished0   <= next_finished0;\n            finished1   <= next_finished1;\n        end\n    end\n\nendmodule"}}
