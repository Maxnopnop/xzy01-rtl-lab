{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"```systemverilog\nmodule request_delay (\n    input  clk,\n    input  rst_n,\n    input  din,\n    output q\n);\n\n    localparam [1:0] IDLE     = 2'b00;\n    localparam [1:0] ASSERT_Q = 2'b01;\n    localparam [1:0] COOLDOWN = 2'b10;\n\n    reg [1:0] state;\n    reg [1:0] next_state;\n\n    always @(*) begin\n        case (state)\n            IDLE: begin\n                if (din)\n                    next_state = ASSERT_Q;\n                else\n                    next_state = IDLE;\n            end\n\n            ASSERT_Q: begin\n                next_state = COOLDOWN;\n            end\n\n            COOLDOWN: begin\n                if (din)\n                    next_state = COOLDOWN;\n                else\n                    next_state = IDLE;\n            end\n\n            default: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= IDLE;\n        else\n            state <= next_state;\n    end\n\n    assign q = (state == ASSERT_Q);\n\nendmodule\n```"}}
