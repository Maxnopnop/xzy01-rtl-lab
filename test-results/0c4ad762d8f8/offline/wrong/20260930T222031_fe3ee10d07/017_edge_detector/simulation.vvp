v0x5f24701fb8a0_0 .var "rst", 0 0;
v0x5f24701fb970 .array "vectors", 260 0, 2 0;
S_0x5f24701a3500 .scope task, "check_value" "check_value" 3 12, 3 12 0, S_0x5f24701dcfd0;
 .timescale -9 -12;
v0x5f24701a3690_0 .var "expected", 0 0;
TD_tb.check_value ;
    %load/vec4 v0x5f24701fb0d0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5f24701fb0d0_0, 0, 32;
    %load/vec4 v0x5f24701fb7e0_0;
    %load/vec4 v0x5f24701a3690_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x5f24701fb390_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5f24701fb390_0, 0, 32;
    %load/vec4 v0x5f24701fb390_0;
    %cmpi/s 8, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_0.2, 5;
    %load/vec4 v0x5f24701fb7e0_0;
    %vpi_call/w 3 17 "$display", "Mismatch vector=%0d got=%h want=%h", v0x5f24701fb540_0, S<0,vec4,u1>, v0x5f24701a3690_0 {1 0 0};
T_0.2 ;
T_0.0 ;
    %end;
S_0x5f24701faac0 .scope module, "dut" "edge_detector" 3 7, 4 1 0, S_0x5f24701dcfd0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "din";
    .port_info 3 /OUTPUT 1 "pulse";
v0x5f24701fad50_0 .net "clk", 0 0, v0x5f24701fb1d0_0;  1 drivers
v0x5f24701fae30_0 .net "din", 0 0, v0x5f24701fb290_0;  1 drivers
v0x5f24701faef0_0 .var "pulse", 0 0;
v0x5f24701faf90_0 .net "rst", 0 0, v0x5f24701fb8a0_0;  1 drivers
E_0x5f24701dee20 .event posedge, v0x5f24701fad50_0;
    .scope S_0x5f24701faac0;
T_1 ;
    %wait E_0x5f24701dee20;
    %load/vec4 v0x5f24701faf90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x5f24701faef0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x5f24701fae30_0;
    %assign/vec4 v0x5f24701faef0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5f24701dcfd0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f24701fb1d0_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5f24701fb0d0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5f24701fb390_0, 0, 32;
    %end;
    .thread T_2, $init;
    .scope S_0x5f24701dcfd0;
T_3 ;
    %vpi_call/w 3 22 "$readmemh", "edge_detector_vectors.hex", v0x5f24701fb970 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5f24701fb540_0, 0, 32;
T_3.0 ;
    %load/vec4 v0x5f24701fb540_0;
    %cmpi/s 261, 0, 32;
    %jmp/0xz T_3.1, 5;
    %delay 2000, 0;
    %ix/getv/s 4, v0x5f24701fb540_0;
    %load/vec4a v0x5f24701fb970, 4;
    %parti/s 2, 1, 2;
    %split/vec4 1;
    %store/vec4 v0x5f24701fb290_0, 0, 1;
    %store/vec4 v0x5f24701fb8a0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x5f24701fb540_0;
    %cmpi/s 0, 0, 32;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %jmp/0xz  T_3.2, 5;
    %load/vec4 v0x5f24701fb700_0;
    %store/vec4 v0x5f24701a3690_0, 0, 1;
    %fork TD_tb.check_value, S_0x5f24701a3500;
    %join;
T_3.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f24701fb1d0_0, 0, 1;
    %delay 1000, 0;
    %ix/getv/s 4, v0x5f24701fb540_0;
    %load/vec4a v0x5f24701fb970, 4;
    %parti/s 1, 0, 2;
    %store/vec4 v0x5f24701a3690_0, 0, 1;
    %fork TD_tb.check_value, S_0x5f24701a3500;
    %join;
    %ix/getv/s 4, v0x5f24701fb540_0;
    %load/vec4a v0x5f24701fb970, 4;
    %parti/s 1, 0, 2;
    %store/vec4 v0x5f24701fb700_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f24701fb1d0_0, 0, 1;
    %load/vec4 v0x5f24701fb540_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5f24701fb540_0, 0, 32;
    %jmp T_3.0;
T_3.1 ;
    %vpi_func 3 29 "$value$plusargs" 32, "nonce=%s", v0x5f24701fb620_0 {0 0 0};
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_3.4, 8;
    %vpi_call/w 3 29 "$fatal", 32'sb00000000000000000000000000000001, "Missing nonce" {0 0 0};
T_3.4 ;
    %vpi_func 3 30 "$fopen" 32, "verdict.txt", "w" {0 0 0};
    %store/vec4 v0x5f24701fb430_0, 0, 32;
    %load/vec4 v0x5f24701fb430_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.6, 4;
    %vpi_call/w 3 31 "$fatal", 32'sb00000000000000000000000000000001, "Cannot write receipt" {0 0 0};
T_3.6 ;
    %vpi_call/w 3 32 "$fdisplay", v0x5f24701fb430_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0x5f24701fb620_0, v0x5f24701fb0d0_0, v0x5f24701fb390_0 {0 0 0};
    %vpi_call/w 3 33 "$fclose", v0x5f24701fb430_0 {0 0 0};
    %load/vec4 v0x5f24701fb390_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_3.8, 4;
    %vpi_call/w 3 34 "$fatal", 32'sb00000000000000000000000000000001, "Functional mismatches: %0d", v0x5f24701fb390_0 {0 0 0};
T_3.8 ;
    %vpi_call/w 3 35 "$finish" {0 0 0};
    %end;
    .thread T_3;
