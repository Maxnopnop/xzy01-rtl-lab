:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f24701dce40 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f24701dcfd0 .scope module, "tb" "tb" 3 2;
 .timescale -9 -12;
v0x5f24701fb0d0_0 .var/i "checks", 31 0;
v0x5f24701fb1d0_0 .var "clk", 0 0;
v0x5f24701fb290_0 .var "din", 0 0;
v0x5f24701fb390_0 .var/i "errors", 31 0;
