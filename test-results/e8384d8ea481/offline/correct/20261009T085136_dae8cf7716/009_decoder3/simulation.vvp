 .timescale -9 -12;
v0x5ac1d7c526e0_0 .var "expected", 7 0;
TD_tb.check_value ;
    %load/vec4 v0x5ac1d7ca88e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5ac1d7ca88e0_0, 0, 32;
    %load/vec4 v0x5ac1d7ca8f70_0;
    %load/vec4 v0x5ac1d7c526e0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x5ac1d7ca8a80_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5ac1d7ca8a80_0, 0, 32;
    %load/vec4 v0x5ac1d7ca8a80_0;
    %cmpi/s 8, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_0.2, 5;
    %load/vec4 v0x5ac1d7ca8f70_0;
    %vpi_call/w 3 16 "$display", "Mismatch vector=%0d got=%h want=%h", v0x5ac1d7ca8c00_0, S<0,vec4,u8>, v0x5ac1d7c526e0_0 {1 0 0};
T_0.2 ;
T_0.0 ;
    %end;
S_0x5ac1d7ca80a0 .scope module, "dut" "decoder3" 3 6, 4 1 0, S_0x5ac1d7c8c020;
 .timescale 0 0;
    .port_info 0 /INPUT 3 "index";
    .port_info 1 /INPUT 1 "en";
    .port_info 2 /OUTPUT 8 "y";
L_0x7f572ae30018 .functor BUFT 1, C4<00000001>, C4<0>, C4<0>, C4<0>;
v0x5ac1d7ca82f0_0 .net/2u *"_ivl_0", 7 0, L_0x7f572ae30018;  1 drivers
v0x5ac1d7ca83f0_0 .net *"_ivl_2", 7 0, L_0x5ac1d7ca9090;  1 drivers
L_0x7f572ae30060 .functor BUFT 1, C4<00000000>, C4<0>, C4<0>, C4<0>;
v0x5ac1d7ca84d0_0 .net/2u *"_ivl_4", 7 0, L_0x7f572ae30060;  1 drivers
v0x5ac1d7ca8590_0 .net "en", 0 0, v0x5ac1d7ca89c0_0;  1 drivers
v0x5ac1d7ca8650_0 .net "index", 2 0, v0x5ac1d7ca8d30_0;  1 drivers
v0x5ac1d7ca8780_0 .net "y", 7 0, L_0x5ac1d7ca91b0;  alias, 1 drivers
L_0x5ac1d7ca9090 .shift/l 8, L_0x7f572ae30018, v0x5ac1d7ca8d30_0;
L_0x5ac1d7ca91b0 .functor MUXZ 8, L_0x7f572ae30060, L_0x5ac1d7ca9090, v0x5ac1d7ca89c0_0, C4<>;
    .scope S_0x5ac1d7c8c020;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5ac1d7ca88e0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5ac1d7ca8a80_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5ac1d7c8c020;
T_2 ;
    %vpi_call/w 3 21 "$readmemh", "decoder3_vectors.hex", v0x5ac1d7ca8eb0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5ac1d7ca8c00_0, 0, 32;
T_2.0 ;
    %load/vec4 v0x5ac1d7ca8c00_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_2.1, 5;
    %ix/getv/s 4, v0x5ac1d7ca8c00_0;
    %load/vec4a v0x5ac1d7ca8eb0, 4;
    %parti/s 4, 8, 5;
    %split/vec4 1;
    %store/vec4 v0x5ac1d7ca89c0_0, 0, 1;
    %store/vec4 v0x5ac1d7ca8d30_0, 0, 3;
    %delay 1000, 0;
    %ix/getv/s 4, v0x5ac1d7ca8c00_0;
    %load/vec4a v0x5ac1d7ca8eb0, 4;
    %parti/s 8, 0, 2;
    %store/vec4 v0x5ac1d7c526e0_0, 0, 8;
    %fork TD_tb.check_value, S_0x5ac1d7c52500;
    %join;
    %load/vec4 v0x5ac1d7ca8c00_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5ac1d7ca8c00_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %vpi_func 3 25 "$value$plusargs" 32, "nonce=%s", v0x5ac1d7ca8df0_0 {0 0 0};
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.2, 8;
    %vpi_call/w 3 25 "$fatal", 32'sb00000000000000000000000000000001, "Missing nonce" {0 0 0};
T_2.2 ;
    %vpi_func 3 26 "$fopen" 32, "verdict.txt", "w" {0 0 0};
    %store/vec4 v0x5ac1d7ca8b20_0, 0, 32;
    %load/vec4 v0x5ac1d7ca8b20_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Cannot write receipt" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 28 "$fdisplay", v0x5ac1d7ca8b20_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0x5ac1d7ca8df0_0, v0x5ac1d7ca88e0_0, v0x5ac1d7ca8a80_0 {0 0 0};
    %vpi_call/w 3 29 "$fclose", v0x5ac1d7ca8b20_0 {0 0 0};
    %load/vec4 v0x5ac1d7ca8a80_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.6, 4;
    %vpi_call/w 3 30 "$fatal", 32'sb00000000000000000000000000000001, "Functional mismatches: %0d", v0x5ac1d7ca8a80_0 {0 0 0};
T_2.6 ;
    %vpi_call/w 3 31 "$finish" {0 0 0};
    %end;
    .thread T_2;
