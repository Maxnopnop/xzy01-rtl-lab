:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61a4400d28c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x61a4400d2a50 .scope module, "tb" "tb" 3 2;
 .timescale -9 -12;
v0x61a4400edc00_0 .var "a", 7 0;
v0x61a4400edcc0_0 .var/i "checks", 31 0;
v0x61a4400edd80_0 .var/i "errors", 31 0;
v0x61a4400ede40_0 .var/i "fd", 31 0;
v0x61a4400edf20_0 .var/i "i", 31 0;
v0x61a4400ee050_0 .var "nonce", 255 0;
v0x61a4400ee130_0 .net "parity", 0 0, L_0x61a4400ee290;  1 drivers
v0x61a4400ee1f0 .array "vectors", 255 0, 8 0;
S_0x61a440099500 .scope task, "check_value" "check_value" 3 10, 3 10 0, S_0x61a4400d2a50;
 .timescale -9 -12;
v0x61a4400996e0_0 .var "expected", 0 0;
TD_tb.check_value ;
    %load/vec4 v0x61a4400edcc0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x61a4400edcc0_0, 0, 32;
    %load/vec4 v0x61a4400ee130_0;
    %load/vec4 v0x61a4400996e0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x61a4400edd80_0;
    %addi 1, 0, 32;
    %store/vec4 v0x61a4400edd80_0, 0, 32;
    %load/vec4 v0x61a4400edd80_0;
    %cmpi/s 8, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_0.2, 5;
    %load/vec4 v0x61a4400ee130_0;
    %vpi_call/w 3 15 "$display", "Mismatch vector=%0d got=%h want=%h", v0x61a4400edf20_0, S<0,vec4,u1>, v0x61a4400996e0_0 {1 0 0};
T_0.2 ;
T_0.0 ;
    %end;
S_0x61a4400ed7e0 .scope module, "dut" "parity8" 3 5, 4 1 0, S_0x61a4400d2a50;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /OUTPUT 1 "parity";
v0x61a4400ed9e0_0 .net "a", 7 0, v0x61a4400edc00_0;  1 drivers
v0x61a4400edae0_0 .net "parity", 0 0, L_0x61a4400ee290;  alias, 1 drivers
L_0x61a4400ee290 .reduce/xnor v0x61a4400edc00_0;
    .scope S_0x61a4400d2a50;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x61a4400edcc0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x61a4400edd80_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x61a4400d2a50;
T_2 ;
    %vpi_call/w 3 20 "$readmemh", "parity8_vectors.hex", v0x61a4400ee1f0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x61a4400edf20_0, 0, 32;
T_2.0 ;
    %load/vec4 v0x61a4400edf20_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_2.1, 5;
    %ix/getv/s 4, v0x61a4400edf20_0;
    %load/vec4a v0x61a4400ee1f0, 4;
    %parti/s 8, 1, 2;
    %store/vec4 v0x61a4400edc00_0, 0, 8;
    %delay 1000, 0;
    %ix/getv/s 4, v0x61a4400edf20_0;
    %load/vec4a v0x61a4400ee1f0, 4;
    %parti/s 1, 0, 2;
    %store/vec4 v0x61a4400996e0_0, 0, 1;
    %fork TD_tb.check_value, S_0x61a440099500;
    %join;
    %load/vec4 v0x61a4400edf20_0;
    %addi 1, 0, 32;
    %store/vec4 v0x61a4400edf20_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %vpi_func 3 24 "$value$plusargs" 32, "nonce=%s", v0x61a4400ee050_0 {0 0 0};
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.2, 8;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "Missing nonce" {0 0 0};
T_2.2 ;
    %vpi_func 3 25 "$fopen" 32, "verdict.txt", "w" {0 0 0};
    %store/vec4 v0x61a4400ede40_0, 0, 32;
    %load/vec4 v0x61a4400ede40_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 26 "$fatal", 32'sb00000000000000000000000000000001, "Cannot write receipt" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 27 "$fdisplay", v0x61a4400ede40_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0x61a4400ee050_0, v0x61a4400edcc0_0, v0x61a4400edd80_0 {0 0 0};
    %vpi_call/w 3 28 "$fclose", v0x61a4400ede40_0 {0 0 0};
    %load/vec4 v0x61a4400edd80_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.6, 4;
    %vpi_call/w 3 29 "$fatal", 32'sb00000000000000000000000000000001, "Functional mismatches: %0d", v0x61a4400edd80_0 {0 0 0};
T_2.6 ;
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
