#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5beef6baeba0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5beef6baed30 .scope module, "tb" "tb" 3 2;
 .timescale -9 -12;
v0x5beef6bcadb0_0 .var "binary", 7 0;
v0x5beef6bcae70_0 .var/i "checks", 31 0;
v0x5beef6bcaf30_0 .var/i "errors", 31 0;
v0x5beef6bcaff0_0 .var/i "fd", 31 0;
v0x5beef6bcb0d0_0 .net "gray", 7 0, L_0x5beef6bcb6f0;  1 drivers
v0x5beef6bcb1e0_0 .var/i "i", 31 0;
v0x5beef6bcb2a0_0 .var "nonce", 255 0;
v0x5beef6bcb380 .array "vectors", 255 0, 15 0;
S_0x5beef6b75500 .scope task, "check_value" "check_value" 3 10, 3 10 0, S_0x5beef6baed30;
 .timescale -9 -12;
v0x5beef6b756e0_0 .var "expected", 7 0;
TD_tb.check_value ;
    %load/vec4 v0x5beef6bcae70_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5beef6bcae70_0, 0, 32;
    %load/vec4 v0x5beef6bcb0d0_0;
    %load/vec4 v0x5beef6b756e0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x5beef6bcaf30_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5beef6bcaf30_0, 0, 32;
    %load/vec4 v0x5beef6bcaf30_0;
    %cmpi/s 8, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_0.2, 5;
    %load/vec4 v0x5beef6bcb0d0_0;
    %vpi_call/w 3 15 "$display", "Mismatch vector=%0d got=%h want=%h", v0x5beef6bcb1e0_0, S<0,vec4,u8>, v0x5beef6b756e0_0 {1 0 0};
T_0.2 ;
T_0.0 ;
    %end;
S_0x5beef6bca6a0 .scope module, "dut" "gray8" 3 5, 4 1 0, S_0x5beef6baed30;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "binary";
    .port_info 1 /OUTPUT 8 "gray";
L_0x5beef6bcb6f0 .functor XOR 8, v0x5beef6bcadb0_0, L_0x5beef6bcb560, C4<00000000>, C4<00000000>;
v0x5beef6bca8a0_0 .net *"_ivl_0", 7 0, L_0x5beef6bcb560;  1 drivers
v0x5beef6bca9a0_0 .net *"_ivl_2", 6 0, L_0x5beef6bcb440;  1 drivers
L_0x748522ea3018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5beef6bcaa80_0 .net *"_ivl_4", 0 0, L_0x748522ea3018;  1 drivers
v0x5beef6bcab40_0 .net "binary", 7 0, v0x5beef6bcadb0_0;  1 drivers
v0x5beef6bcac20_0 .net "gray", 7 0, L_0x5beef6bcb6f0;  alias, 1 drivers
L_0x5beef6bcb440 .part v0x5beef6bcadb0_0, 0, 7;
L_0x5beef6bcb560 .concat [ 1 7 0 0], L_0x748522ea3018, L_0x5beef6bcb440;
    .scope S_0x5beef6baed30;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5beef6bcae70_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5beef6bcaf30_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5beef6baed30;
T_2 ;
    %vpi_call/w 3 20 "$readmemh", "gray8_vectors.hex", v0x5beef6bcb380 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5beef6bcb1e0_0, 0, 32;
T_2.0 ;
    %load/vec4 v0x5beef6bcb1e0_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_2.1, 5;
    %ix/getv/s 4, v0x5beef6bcb1e0_0;
    %load/vec4a v0x5beef6bcb380, 4;
    %parti/s 8, 8, 5;
    %store/vec4 v0x5beef6bcadb0_0, 0, 8;
    %delay 1000, 0;
    %ix/getv/s 4, v0x5beef6bcb1e0_0;
    %load/vec4a v0x5beef6bcb380, 4;
    %parti/s 8, 0, 2;
    %store/vec4 v0x5beef6b756e0_0, 0, 8;
    %fork TD_tb.check_value, S_0x5beef6b75500;
    %join;
    %load/vec4 v0x5beef6bcb1e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5beef6bcb1e0_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %vpi_func 3 24 "$value$plusargs" 32, "nonce=%s", v0x5beef6bcb2a0_0 {0 0 0};
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.2, 8;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "Missing nonce" {0 0 0};
T_2.2 ;
    %vpi_func 3 25 "$fopen" 32, "verdict.txt", "w" {0 0 0};
    %store/vec4 v0x5beef6bcaff0_0, 0, 32;
    %load/vec4 v0x5beef6bcaff0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 26 "$fatal", 32'sb00000000000000000000000000000001, "Cannot write receipt" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 27 "$fdisplay", v0x5beef6bcaff0_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0x5beef6bcb2a0_0, v0x5beef6bcae70_0, v0x5beef6bcaf30_0 {0 0 0};
    %vpi_call/w 3 28 "$fclose", v0x5beef6bcaff0_0 {0 0 0};
    %load/vec4 v0x5beef6bcaf30_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.6, 4;
    %vpi_call/w 3 29 "$fatal", 32'sb00000000000000000000000000000001, "Functional mismatches: %0d", v0x5beef6bcaf30_0 {0 0 0};
T_2.6 ;
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "dut.sv";
