    %addi 1, 0, 32;
    %store/vec4 v0x5d5f78f4b3a0_0, 0, 32;
    %load/vec4 v0x5d5f78f4b3a0_0;
    %cmpi/s 8, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_0.2, 5;
    %load/vec4 v0x5d5f78f4b7e0_0;
    %vpi_call/w 3 16 "$display", "Mismatch vector=%0d got=%h want=%h", v0x5d5f78f4b560_0, S<0,vec4,u8>, v0x5d5f78ef26e0_0 {1 0 0};
T_0.2 ;
T_0.0 ;
    %end;
S_0x5d5f78f4a4e0 .scope module, "dut" "saturating8" 3 6, 4 1 0, S_0x5d5f78f2caa0;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "y";
