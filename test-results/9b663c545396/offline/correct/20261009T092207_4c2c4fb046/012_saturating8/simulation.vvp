v0x5d5f78f4b040_0 .net "y", 7 0, L_0x5d5f78f4bf30;  alias, 1 drivers
L_0x5d5f78f4b960 .concat [ 8 1 0 0], v0x5d5f78f4b1a0_0, L_0x75c9cd586018;
L_0x5d5f78f4ba80 .concat [ 8 1 0 0], v0x5d5f78f4b260_0, L_0x75c9cd586060;
L_0x5d5f78f4bbc0 .arith/sum 9, L_0x5d5f78f4b960, L_0x5d5f78f4ba80;
L_0x5d5f78f4bd70 .part L_0x5d5f78f4bbc0, 8, 1;
L_0x5d5f78f4be90 .part L_0x5d5f78f4bbc0, 0, 8;
L_0x5d5f78f4bf30 .functor MUXZ 8, L_0x5d5f78f4be90, L_0x75c9cd5860a8, L_0x5d5f78f4bd70, C4<>;
    .scope S_0x5d5f78f2caa0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5d5f78f4b300_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5d5f78f4b3a0_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5d5f78f2caa0;
T_2 ;
    %vpi_call/w 3 21 "$readmemh", "saturating8_vectors.hex", v0x5d5f78f4b720 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5d5f78f4b560_0, 0, 32;
T_2.0 ;
    %load/vec4 v0x5d5f78f4b560_0;
    %cmpi/s 2560, 0, 32;
    %jmp/0xz T_2.1, 5;
    %ix/getv/s 4, v0x5d5f78f4b560_0;
    %load/vec4a v0x5d5f78f4b720, 4;
    %parti/s 16, 8, 5;
    %split/vec4 8;
    %store/vec4 v0x5d5f78f4b260_0, 0, 8;
    %store/vec4 v0x5d5f78f4b1a0_0, 0, 8;
    %delay 1000, 0;
    %ix/getv/s 4, v0x5d5f78f4b560_0;
    %load/vec4a v0x5d5f78f4b720, 4;
    %parti/s 8, 0, 2;
    %store/vec4 v0x5d5f78ef26e0_0, 0, 8;
    %fork TD_tb.check_value, S_0x5d5f78ef2500;
    %join;
    %load/vec4 v0x5d5f78f4b560_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5d5f78f4b560_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %vpi_func 3 25 "$value$plusargs" 32, "nonce=%s", v0x5d5f78f4b640_0 {0 0 0};
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.2, 8;
    %vpi_call/w 3 25 "$fatal", 32'sb00000000000000000000000000000001, "Missing nonce" {0 0 0};
T_2.2 ;
    %vpi_func 3 26 "$fopen" 32, "verdict.txt", "w" {0 0 0};
    %store/vec4 v0x5d5f78f4b480_0, 0, 32;
    %load/vec4 v0x5d5f78f4b480_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Cannot write receipt" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 28 "$fdisplay", v0x5d5f78f4b480_0, "RTL_LAB_V1 %0s checks=%0d errors=%0d", v0x5d5f78f4b640_0, v0x5d5f78f4b300_0, v0x5d5f78f4b3a0_0 {0 0 0};
    %vpi_call/w 3 29 "$fclose", v0x5d5f78f4b480_0 {0 0 0};
    %load/vec4 v0x5d5f78f4b3a0_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.6, 4;
    %vpi_call/w 3 30 "$fatal", 32'sb00000000000000000000000000000001, "Functional mismatches: %0d", v0x5d5f78f4b3a0_0 {0 0 0};
T_2.6 ;
    %vpi_call/w 3 31 "$finish" {0 0 0};
    %end;
    .thread T_2;
