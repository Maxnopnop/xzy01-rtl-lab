      },
      "ports": {
        "reset_port": "rst_n",
        "input_port": "din",
        "output_port": "q",
        "active": 0
      },
      "public_contract": {
        "clock_edge": "posedge",
        "output_kind": "moore",
        "reset": {
          "kind": "async",
          "active": 0,
          "output": 0
        },
        "trace_convention": "Each trace starts after reset; output is sampled after every rising edge.",
        "examples": [
