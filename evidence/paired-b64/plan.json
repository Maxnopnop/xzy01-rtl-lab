    {
      "id": "sticky_alarm",
      "module": "sticky_alarm",
      "category": "fsm",
      "family": "sticky_alarm",
      "split": "development",
      "spec": "Implement module sticky_alarm(input clk, input rst_n, input din, output q). Use rising clock edges, asynchronous active-low reset, and Moore outputs. q starts at 0. Two consecutive sampled ones set q to 1. Once set, q remains 1 until reset, regardless of later input. A zero before activation breaks the consecutive-one count.",
