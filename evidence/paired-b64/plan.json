    {
      "id": "event_parity",
      "module": "event_parity",
      "category": "fsm",
      "family": "event_parity",
      "split": "development",
      "spec": "Implement module event_parity(input clk, input rst_n, input din, output q). Use rising clock edges, asynchronous active-low reset, and Moore outputs. q starts at 0. On each rising clock edge with din=1, toggle q. With din=0 hold q. Thus q is the parity of the number of sampled ones since reset.",
      "checks": 9216,
